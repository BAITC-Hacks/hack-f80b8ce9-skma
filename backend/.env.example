APP_NAME="Hackathon API"
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ekt
# ekt.kz partner API (Basic Auth). Real values only in backend/.env
EKT_API_URL=https://ekt.kz/api
EKT_API_USER=changeme
EKT_API_PASSWORD=changeme
EKT_SYNC_PAGES=0
# LLM: any OpenAI-compatible API. Empty OPENAI_API_KEY -> rule-based assistant without LLM.
# Hybrid mode: main LLM = Qwen on build.nvidia.com (dialog + tools), key starts with nvapi-.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3-next-80b-a3b-instruct
# Only for OpenAI reasoning models (minimal | low | medium); leave empty for Qwen.
OPENAI_REASONING_EFFORT=
# OpenAI instead:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4-mini
# Kazakh model (Sherkala-8B via vLLM on NVIDIA Brev) rewrites replies to Kazakh questions.
# Empty KAZAKH_LLM_BASE_URL -> off.
KAZAKH_LLM_BASE_URL=
# KAZAKH_LLM_BASE_URL=https://<your-brev-url>/v1
KAZAKH_LLM_API_KEY=changeme
KAZAKH_LLM_MODEL=inception42/Llama-3.1-Sherkala-8B-Chat
