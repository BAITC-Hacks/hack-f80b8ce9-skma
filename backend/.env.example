APP_NAME="Hackathon API"
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ekt
# ekt.kz partner API (Basic Auth). Real values only in backend/.env
EKT_API_URL=https://ekt.kz/api
EKT_API_USER=changeme
EKT_API_PASSWORD=changeme
EKT_SYNC_PAGES=0
# LLM: any OpenAI-compatible API. Empty OPENAI_API_KEY -> rule-based assistant without LLM.
# OpenAI (default):
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional for reasoning models: minimal | low | medium
OPENAI_REASONING_EFFORT=
# NVIDIA build.nvidia.com instead:
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=meta/llama-3.3-70b-instruct
